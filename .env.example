# Скопируйте в .env и заполните значения.
#
# PostgreSQL НЕ входит в docker-compose.yml — он ставится нативно на хост
# (см. README.md, раздел "PostgreSQL на хосте"), общий для нескольких
# проектов на сервере. Подсеть compose-проекта зафиксирована в
# docker-compose.yml (networks.default.ipam: 172.28.0.0/24, шлюз
# 172.28.0.1) — POSTGRES_HOST ниже указывает прямо на этот шлюз, не трогайте
# (host.docker.internal здесь ненадёжен — в некоторых конфигурациях Docker
# резолвит его в адрес дефолтной сети docker0, а не сети этого проекта).
#
# CELERY_BROKER_URL=redis://redis:6379/0 — это имя сервиса redis из
# docker-compose.yml, он резолвится только внутри его сети, не трогайте.
#
# Для запуска БЕЗ Docker вообще (локальный `python manage.py ...`)
# замените POSTGRES_HOST на localhost и CELERY_BROKER_URL/
# CELERY_RESULT_BACKEND — тоже на localhost.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Moscow

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=172.28.0.1
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=crm@example.local

# Число месяца формирования начислений (1 или 2)
BILLING_GENERATION_DAY=1
# За сколько дней до окончания договора предупреждать ответственных
CONTRACT_EXPIRY_WARNING_DAYS=30
