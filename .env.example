# Скопируйте в .env и заполните значения.
#
# Для docker compose ничего менять не нужно (POSTGRES_HOST=db,
# CELERY_BROKER_URL=redis://redis:6379/0 — это имена сервисов в
# docker-compose.yml, они резолвятся только внутри его сети).
#
# Для запуска БЕЗ Docker (локальный `python manage.py ...`) обязательно
# замените POSTGRES_HOST на localhost (или адрес вашего PostgreSQL) и
# CELERY_BROKER_URL/CELERY_RESULT_BACKEND — на localhost, у вас должны быть
# подняты локальные PostgreSQL и Redis с этими же данными для входа.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Europe/Moscow

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=crm@example.local

# Число месяца формирования начислений (1 или 2)
BILLING_GENERATION_DAY=1
# За сколько дней до окончания договора предупреждать ответственных
CONTRACT_EXPIRY_WARNING_DAYS=30
